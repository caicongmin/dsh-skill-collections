{
  "name": "@dsh-external/dsh-skill-collections",
  "version": "0.1.4",
  "description": "DSH Skill 收藏夹管理器：集中管理 Skill、收藏夹与工作区显式绑定，并同步到原生 .dsh/skills。",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "docs/screenshots",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "docs/store-review.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caicongmin/dsh-skill-collections.git"
  },
  "homepage": "https://github.com/caicongmin/dsh-skill-collections#readme",
  "bugs": {
    "url": "https://github.com/caicongmin/dsh-skill-collections/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dependencies": {
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.2-alpha.1 <0.2 || >=0.2.1-alpha.1 <0.3",
    "@deepseek-ai/dsh-host-webserver": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-workspace": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-api-session-controller": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.0.1-rc <2",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "lightningcss": "^1.32.0",
    "typescript": "^5.9.0",
    "tsdown": "^0.22.2"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:host:bundle": "node node_modules/tsdown/dist/run.mjs --config tsdown.host.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:client": "node node_modules/tsdown/dist/run.mjs",
    "pack:npm": "node scripts/pack-npm.mjs",
    "verify:npm": "node scripts/verify-npm-package.mjs",
    "verify:profile": "node scripts/verify-disposable-profile.mjs",
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "test": "npm run validate:manifest && node tests/smoke.mjs && node --test tests/*.test.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  }
}
